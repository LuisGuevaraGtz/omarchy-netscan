#!/usr/bin/env python3
import sys
import subprocess
import json
import re
import shutil
import os
import stat
import signal
import select
import tempfile
import time
import fcntl
import hashlib
import xml.etree.ElementTree as ET

# ------------------------------------------------------------------------
# Bounds. Every external process, every string we lift out of its output,
# and the final JSON blob are capped so a hostile or noisy LAN (a device
# that floods arp-scan replies, spoofs a giant DHCP hostname / nmap banner,
# or otherwise tries to make this engine buffer without limit) can only
# ever cost us a small, fixed amount of memory and time.
# ------------------------------------------------------------------------
MAX_PROC_BYTES = 512 * 1024      # cap on a single subprocess's stdout
READ_CHUNK = 65536
MAX_FIELD_LEN = 128               # cap on any single string field (vendor, service, version...)
MAX_DEVICES = 512                 # cap on number of devices in a scan result
MAX_PORTS = 300                   # cap on number of ports in a port-scan result
MAX_JSON_BYTES = 1024 * 1024      # hard backstop on the final serialized JSON
MAX_EXTRA_IPS = 16                # cap on alternate IPs recorded for one MAC (DHCP churn)

# Alias store (user-assigned device nicknames). Config, not scan output, but
# still bounded: a corrupted or hand-edited aliases.json shouldn't be able to
# make the engine buffer or iterate without limit either.
MAX_ALIASES = 512          # cap on entries in aliases.json
MAX_ALIAS_LEN = 48         # cap on characters of a single alias
MAX_CONFIG_BYTES = 128 * 1024      # cap on aliases.json / snapshot file size we'll read

# `inspect` (deep nmap scan) output bounds. product/versionNum/extrainfo/
# httpTitle/tlsCN/upnpModel/banner all reuse MAX_FIELD_LEN via clamp().
MAX_SCRIPT_OUTPUT = 256    # cap per NSE script output
MAX_SCRIPTS_PER_PORT = 6   # cap on number of scripts recorded per port

# `snapshot` (periodic new-device detection) bounds.
MAX_NOTIFICATIONS_PER_RUN = 3      # after this many new devices, send one summary instead
SNAPSHOT_MAX_AGE_DAYS = 30         # prune devices not seen in this long
NOTIFY_BODY_LEN = 96

_MAC_RE = re.compile(r"^[0-9a-f]{2}(:[0-9a-f]{2}){5}$")
_CONTROL_CHARS_RE = re.compile(r"[\x00-\x1f\x7f]")
_IFACE_RE = re.compile(r"^[A-Za-z0-9_.@:-]+$")
_IP_RE = re.compile(r"^\d+\.\d+\.\d+\.\d+$")


def normalize_mac(s):
    """Lowercase + colon-normalize a MAC, or "" if it doesn't validate.

    Every MAC that ends up in devices_dict, the alias store, or a snapshot
    filename goes through here first -- it's the one place that decides
    whether something is allowed to be treated as a MAC address.
    """
    if not s:
        return ""
    s = str(s).strip().lower().replace("-", ":")
    return s if _MAC_RE.match(s) else ""


def sanitize_alias(s):
    """Strip control chars, collapse whitespace, and clamp an alias string."""
    if s is None:
        return ""
    s = _CONTROL_CHARS_RE.sub("", str(s))
    s = re.sub(r"\s+", " ", s).strip()
    return clamp(s, MAX_ALIAS_LEN)


def _xdg_config_home():
    v = os.environ.get("XDG_CONFIG_HOME")
    return v if v else os.path.join(os.path.expanduser("~"), ".config")


def _xdg_state_home():
    v = os.environ.get("XDG_STATE_HOME")
    return v if v else os.path.join(os.path.expanduser("~"), ".local", "state")


def _ensure_dir(path, mode=0o700):
    """mkdir -p `path` and force its mode, regardless of umask."""
    os.makedirs(path, exist_ok=True)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def _read_json_safe(path, max_bytes):
    """Read+parse a small JSON file defensively. Never raises.

    Refuses symlinks (O_NOFOLLOW), non-regular files, and anything over
    max_bytes. Returns None on any failure -- callers treat that the same
    as "file doesn't exist / has no usable content".
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    f = None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > max_bytes:
            os.close(fd)
            return None
        f = os.fdopen(fd, "rb")
        data = f.read(max_bytes + 1)
        if len(data) > max_bytes:
            return None
        return json.loads(data.decode("utf-8", "replace"))
    except Exception:
        return None
    finally:
        if f is not None:
            try:
                f.close()
            except Exception:
                pass


def _write_json_atomic(path, obj, file_mode=0o600):
    """Write JSON to `path` atomically: temp file in the same dir, fsync,
    os.replace(). Never truncates the target in place. Returns True/False.
    """
    dir_name = os.path.dirname(path) or "."
    _ensure_dir(dir_name)
    try:
        fd_tmp, tmp_path = tempfile.mkstemp(prefix=".tmp-", dir=dir_name)
    except OSError:
        return False
    try:
        with os.fdopen(fd_tmp, "w") as tf:
            json.dump(obj, tf)
            tf.flush()
            os.fsync(tf.fileno())
        os.chmod(tmp_path, file_mode)
        os.replace(tmp_path, path)
        return True
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        return False


def alias_path():
    """Resolve the aliases.json path. Does not create anything."""
    return os.path.join(_xdg_config_home(), "omarchy-netscan", "aliases.json")


def load_aliases():
    """Return dict[mac, name]. Never raises -- any problem just yields {}."""
    data = _read_json_safe(alias_path(), MAX_CONFIG_BYTES)
    if not isinstance(data, dict):
        return {}
    raw = data.get("aliases")
    if not isinstance(raw, dict):
        return {}
    out = {}
    for k, v in raw.items():
        if len(out) >= MAX_ALIASES:
            break
        mac = normalize_mac(k)
        if not mac:
            continue
        name = sanitize_alias(v)
        if not name:
            continue
        out[mac] = name
    return out


def save_aliases(d):
    if len(d) > MAX_ALIASES:
        d = dict(list(d.items())[:MAX_ALIASES])
    return _write_json_atomic(alias_path(), {"schemaVersion": 1, "aliases": d})


def _read_local_mac(iface):
    """Read the real MAC of `iface` straight from sysfs (no subprocess)."""
    if not iface or not _IFACE_RE.match(iface):
        return ""
    path = f"/sys/class/net/{iface}/address"
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return ""
    try:
        with os.fdopen(fd, "r") as f:
            mac = f.read(128)
    except OSError:
        return ""
    return normalize_mac(mac.strip())


def _kill_process_group(proc):
    """Best-effort kill of the whole process group we spawned the command in."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        pass


def run_bounded(cmd, timeout, max_bytes=MAX_PROC_BYTES):
    """Run cmd in its own process group and return (stdout_bytes, truncated, timed_out).

    Unlike subprocess.run(capture_output=True), this never buffers more than
    max_bytes of stdout. On overflow *or* timeout the entire process group
    (not just the immediate child) is killed with SIGKILL, so a helper
    process spawned by nmap/arp-scan can't keep running or writing after we
    give up on it.
    """
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,  # own process group -> safe to killpg
        )
    except (OSError, ValueError):
        return b"", False, False

    chunks = []
    total = 0
    truncated = False
    timed_out = False
    deadline = time.monotonic() + timeout
    fd = proc.stdout.fileno()

    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                break
            try:
                ready, _, _ = select.select([fd], [], [], remaining)
            except (OSError, ValueError):
                break
            if not ready:
                timed_out = True
                break
            try:
                data = os.read(fd, READ_CHUNK)
            except OSError:
                break
            if not data:
                break  # EOF, process finished producing output
            if total + len(data) > max_bytes:
                data = data[: max_bytes - total]
                if data:
                    chunks.append(data)
                    total += len(data)
                truncated = True
                break
            chunks.append(data)
            total += len(data)
    finally:
        if truncated or timed_out:
            _kill_process_group(proc)
        try:
            proc.stdout.close()
        except Exception:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            _kill_process_group(proc)
            try:
                proc.wait(timeout=2)
            except Exception:
                pass

    return b"".join(chunks), truncated, timed_out


def clamp(s, limit=MAX_FIELD_LEN):
    """Bound the length of a string field lifted from untrusted process output."""
    if s is None:
        return ""
    s = str(s).strip()
    if len(s) > limit:
        s = s[:limit].rstrip() + "…"
    return s


def emit_json(obj):
    """Serialize obj, shrinking list fields if needed to stay under MAX_JSON_BYTES.

    Per-field and per-list-item caps already keep normal output well within
    budget; this is a defensive backstop, not the primary control.
    """
    data = json.dumps(obj)
    if len(data.encode("utf-8", "replace")) <= MAX_JSON_BYTES:
        print(data)
        return

    obj["truncated"] = True
    for list_key, count_key in (("devices", "deviceCount"), ("ports", "portCount")):
        items = obj.get(list_key)
        if not isinstance(items, list):
            continue
        while items and len(json.dumps(obj).encode("utf-8", "replace")) > MAX_JSON_BYTES:
            items.pop()
        obj[count_key] = len(items)

    print(json.dumps(obj))


def get_network_details():
    iface = ""
    gateway = ""
    subnet = ""
    local_ip = ""

    try:
        raw, _, _ = run_bounded(["ip", "route"], timeout=2, max_bytes=64 * 1024)
        route_out = raw.decode("utf-8", "replace")
        for line in route_out.splitlines():
            if line.startswith("default"):
                parts = line.split()
                if "via" in parts:
                    gateway = parts[parts.index("via") + 1]
                if "dev" in parts:
                    iface = parts[parts.index("dev") + 1]
            elif "src" in line and iface and f"dev {iface}" in line:
                parts = line.split()
                if not subnet:
                    subnet = parts[0]
                if "src" in parts:
                    local_ip = parts[parts.index("src") + 1]
    except Exception:
        pass

    return clamp(iface, 32), clamp(gateway, 64), clamp(subnet, 64), clamp(local_ip, 64)


def classify_device(ip, mac, vendor, gateway, local_ip):
    v_lower = vendor.lower()
    is_gw = (ip == gateway)
    is_self = (ip == local_ip)

    if is_gw:
        return "󰒋", "Router / Gateway", True, False
    if is_self:
        return "󰍹", "This Device", False, True

    # Phone / Tablet
    if any(k in v_lower for k in ["apple", "samsung", "xiaomi", "pixel", "oneplus", "motorola", "huawei phone", "oppo", "vivo"]):
        return "󰄡", "Phone / Mobile", False, False

    # Smart device / IoT / Camera
    if any(k in v_lower for k in ["wyze", "amazon", "tuya", "sonoff", "nest", "roku", "espressif", "ring", "philips", "tp-link", "shelly"]):
        return "󰛳", "Smart IoT Device", False, False

    # PC / Laptop
    if any(k in v_lower for k in ["intel", "dell", "hp", "lenovo", "asus", "gigabyte", "msi", "realtek", "asrock", "micro-star", "framework"]):
        return "󰌢", "Computer / Laptop", False, False

    # Generic Network / Other
    return "󰛳", "Network Host", False, False


def _discover_devices():
    """Run arp-scan + local host + `ip neigh` discovery.

    Returns (iface, gateway, subnet, local_ip, devices_list). devices_list
    is already MAC-deduped (one entry per distinct MAC, extra IPs folded
    into "extraIps") and sorted gateway-first/self-second/numeric-IP after.
    Carries no "alias" field -- callers that want aliases attach them.
    """
    iface, gateway, subnet, local_ip = get_network_details()
    devices_dict = {}   # key: normalized MAC, or "self:<ip>" if we couldn't read one

    def add_or_merge(key, entry):
        existing = devices_dict.get(key)
        if existing is not None:
            ip = entry["ip"]
            if ip != existing["ip"] and ip not in existing["extraIps"] and len(existing["extraIps"]) < MAX_EXTRA_IPS:
                existing["extraIps"].append(ip)
            return
        if len(devices_dict) >= MAX_DEVICES:
            return
        entry["extraIps"] = []
        devices_dict[key] = entry

    # 1. Try arp-scan first (fastest and gives MAC vendor)
    arp_scan_bin = shutil.which("arp-scan")
    if arp_scan_bin:
        try:
            cmd = [arp_scan_bin, "--localnet"]
            if iface:
                cmd.extend(["--interface", iface])
            raw, _, _ = run_bounded(cmd, timeout=6, max_bytes=MAX_PROC_BYTES)
            stdout = raw.decode("utf-8", "replace")
            for line in stdout.splitlines():
                if len(devices_dict) >= MAX_DEVICES:
                    break
                line = line.strip()
                match = re.match(r"^(\d+\.\d+\.\d+\.\d+)\s+([0-9a-fA-F:]{17})\s+(.*)$", line)
                if not match:
                    continue
                ip, mac_raw, vendor = match.groups()
                mac = normalize_mac(mac_raw)
                if not mac:
                    continue
                vendor = clamp(vendor)
                if vendor == "(Unknown: locally administered)":
                    vendor = "Locally Administered"
                elif vendor == "(Unknown)":
                    vendor = "Unknown Vendor"

                icon, category, is_gw, is_self = classify_device(ip, mac, vendor, gateway, local_ip)
                add_or_merge(mac, {
                    "ip": ip,
                    "mac": mac,
                    "vendor": vendor,
                    "icon": icon,
                    "category": category,
                    "isGateway": is_gw,
                    "isSelf": is_self
                })
        except Exception:
            pass

    # 2. Add local host if not already present under some MAC
    local_present = any(d["ip"] == local_ip for d in devices_dict.values()) if local_ip else True
    if local_ip and not local_present and len(devices_dict) < MAX_DEVICES:
        local_mac = _read_local_mac(iface)
        key = local_mac if local_mac else f"self:{local_ip}"
        add_or_merge(key, {
            "ip": local_ip,
            "mac": local_mac,  # "" if we couldn't read it -- UI shouldn't show junk
            "vendor": "This Computer",
            "icon": "󰍹",
            "category": "This Device",
            "isGateway": False,
            "isSelf": True
        })

    # 3. Complement with `ip neigh show`, deduped by MAC. An IP already
    # accounted for (as a primary IP or an extraIp) is skipped rather than
    # trusted again here -- the kernel neighbor table can be stale and we'd
    # rather not spawn a conflicting-MAC duplicate for an IP arp-scan already
    # resolved.
    try:
        raw, _, _ = run_bounded(["ip", "-4", "neigh", "show"], timeout=2, max_bytes=256 * 1024)
        neigh_out = raw.decode("utf-8", "replace")
        seen_ips = set()
        for d in devices_dict.values():
            seen_ips.add(d["ip"])
            seen_ips.update(d["extraIps"])
        for line in neigh_out.splitlines():
            if len(devices_dict) >= MAX_DEVICES:
                break
            parts = line.split()
            if len(parts) < 4 or "lladdr" not in parts:
                continue
            ip = parts[0]
            mac = normalize_mac(parts[parts.index("lladdr") + 1])
            state = parts[-1]
            if not mac or state not in ("REACHABLE", "STALE", "DELAY", "PROBE") or ip in seen_ips:
                continue
            icon, category, is_gw, is_self = classify_device(ip, mac, "Unknown Host", gateway, local_ip)
            add_or_merge(mac, {
                "ip": ip,
                "mac": mac,
                "vendor": "Network Device",
                "icon": icon,
                "category": category,
                "isGateway": is_gw,
                "isSelf": is_self
            })
            seen_ips.add(ip)
    except Exception:
        pass

    # Sort devices: Gateway first, then This PC, then by IPv4 numerical address
    def sort_key(d):
        if d["isGateway"]:
            return (0, 0, 0, 0, 0)
        if d["isSelf"]:
            return (1, 0, 0, 0, 0)
        try:
            octets = [int(x) for x in d["ip"].split(".")]
            return (2, *octets)
        except Exception:
            return (3, 0, 0, 0, 0)

    devices_list = sorted(devices_dict.values(), key=sort_key)
    return iface, gateway, subnet, local_ip, devices_list


def _attach_aliases(devices_list):
    """Load the alias store once and stamp each device's "alias" field
    in place. MAC-less synthetic entries ("self:<ip>") get "" -- their
    "mac" field is already "" and can't match anything in the store.
    """
    aliases = load_aliases()
    for d in devices_list:
        d["alias"] = aliases.get(d["mac"], "") if d["mac"] else ""


def scan_network():
    iface, gateway, subnet, local_ip, devices_list = _discover_devices()
    _attach_aliases(devices_list)

    output = {
        "status": "ok",
        "iface": iface or "unknown",
        "gateway": gateway or "unknown",
        "subnet": subnet or "unknown",
        "localIp": local_ip or "unknown",
        "deviceCount": len(devices_list),
        "devices": devices_list
    }
    emit_json(output)


def state_dir():
    return os.path.join(_xdg_state_home(), "omarchy-netscan")


def _path_within(path, base_dir):
    """True iff the realpath of `path` sits inside the realpath of `base_dir`."""
    try:
        rp = os.path.realpath(path)
        rb = os.path.realpath(base_dir)
    except OSError:
        return False
    return rp == rb or rp.startswith(rb + os.sep)


def snapshot_path(network_key):
    """Map a (already-validated) network key to its snapshot file.

    The key can come from arp-scan's view of the gateway's MAC -- i.e. from
    a device on the LAN that could try to spoof it -- and it ends up as
    part of a filename, so the raw key is never interpolated into the
    path. hashlib.sha256(...).hexdigest()[:16] means the filename is
    always exactly "snapshot-<16 hex chars>.json" by construction,
    regardless of what the key contains; the human-readable key itself is
    stored inside the JSON ("network" field), never in the path.
    """
    digest = hashlib.sha256(network_key.encode("utf-8", "replace")).hexdigest()[:16]
    return os.path.join(state_dir(), f"snapshot-{digest}.json")


def _network_key(gateway, devices_list, subnet):
    """Gateway MAC if we can find one, else the subnet, else "".

    The gateway MAC is what makes this usable on a laptop that roams
    between networks -- without it, every new Wi-Fi joined would look
    like a LAN full of "new" devices.
    """
    gw_mac = ""
    for d in devices_list:
        if d.get("ip") == gateway and d.get("mac"):
            gw_mac = d["mac"]
            break
    if gw_mac:
        # Already normalized by _discover_devices, but re-validate here too
        # -- this value is about to become part of a filename (by way of
        # its hash), and we'd rather abort than trust a MAC-shaped string
        # we didn't re-check ourselves.
        return normalize_mac(gw_mac)
    return clamp(subnet, 64) if subnet else ""


def _with_state_lock(path, fn):
    """Hold an exclusive flock on `path` (creating it if needed) for the
    duration of fn(). Serializes the timer run against a manual `snapshot`
    invocation racing it. Best-effort: if we can't even open the lock file,
    fn() still runs (unlocked) rather than silently doing nothing.
    """
    _ensure_dir(os.path.dirname(path))
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError:
        return fn()
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
        except OSError:
            pass
        return fn()
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass


def _notify_new_devices(new_devices):
    """notify-send about newly seen devices, capped at
    MAX_NOTIFICATIONS_PER_RUN individual pop-ups -- past that, one summary.
    Vendor/IP strings here come from arp-scan's OUI table, i.e. from
    whatever a device on the LAN claims -- clamp + strip control chars, and
    pass args after a bare "--" so a vendor string starting with "-" can't
    be read as a notify-send flag (this is exec'd via argv, never a shell,
    so there's no command-injection angle either way).
    """
    if not new_devices:
        return
    notify_bin = shutil.which("notify-send")
    if not notify_bin:
        return

    def clean(s):
        return clamp(_CONTROL_CHARS_RE.sub("", s or ""), NOTIFY_BODY_LEN)

    title = "Nuevo dispositivo en la red"

    if len(new_devices) > MAX_NOTIFICATIONS_PER_RUN:
        body = clean(f"{len(new_devices)} nuevos dispositivos detectados")
        run_bounded([notify_bin, "-a", "Network Scanner", "--", title, body], timeout=3)
        return

    for d in new_devices[:MAX_NOTIFICATIONS_PER_RUN]:
        label = d.get("vendor") or "Unknown"
        body = clean(f"{d.get('ip', '')} · {label}")
        run_bounded([notify_bin, "-a", "Network Scanner", "--", title, body], timeout=3)


def snapshot():
    """Discover devices, diff against the last snapshot for this network,
    notify about anything new, and persist the merged result. Meant to be
    run by the systemd timer as well as by hand; safe to run concurrently
    with itself thanks to _with_state_lock().
    """
    iface, gateway, subnet, local_ip, devices_list = _discover_devices()
    _attach_aliases(devices_list)

    network_key = _network_key(gateway, devices_list, subnet)
    if not network_key:
        emit_json({"status": "error", "message": "could not determine a network key"})
        return

    path = snapshot_path(network_key)
    if not _path_within(path, state_dir()):
        emit_json({"status": "error", "message": "refusing to write outside the state directory"})
        return

    result = {}

    def _do():
        now = int(time.time())
        existing = _read_json_safe(path, MAX_CONFIG_BYTES) or {}
        existing_devices = existing.get("devices")
        if not isinstance(existing_devices, dict):
            existing_devices = {}

        known_macs = {normalize_mac(m) for m in existing_devices if normalize_mac(m)}

        merged = {}
        new_devices = []
        for d in devices_list:
            mac = d.get("mac") or ""
            if not mac:
                continue  # can't track a MAC-less synthetic "self:" entry across runs
            label = clamp(d.get("alias") or d.get("vendor") or "", MAX_FIELD_LEN)
            prior = existing_devices.get(mac)
            first_seen = now
            if isinstance(prior, dict) and isinstance(prior.get("firstSeen"), int):
                first_seen = prior["firstSeen"]
            merged[mac] = {
                "firstSeen": first_seen,
                "lastSeen": now,
                "lastIp": d["ip"],
                "vendor": label
            }
            if mac not in known_macs:
                new_devices.append({"ip": d["ip"], "mac": mac, "vendor": label})

        # Carry forward devices not seen this run, pruning anything stale.
        cutoff = now - SNAPSHOT_MAX_AGE_DAYS * 24 * 3600
        for mac, info in existing_devices.items():
            nm = normalize_mac(mac)
            if not nm or nm in merged or not isinstance(info, dict):
                continue
            if isinstance(info.get("lastSeen"), int) and info["lastSeen"] >= cutoff:
                merged[nm] = info

        if len(merged) > MAX_DEVICES:
            merged = dict(
                sorted(merged.items(), key=lambda kv: kv[1].get("lastSeen", 0), reverse=True)[:MAX_DEVICES]
            )

        ok = _write_json_atomic(path, {
            "schemaVersion": 1,
            "network": network_key,
            "updated": now,
            "devices": merged
        })
        result["ok"] = ok
        result["new"] = new_devices
        result["known"] = max(0, len(merged) - len(new_devices))

    _with_state_lock(path, _do)

    if not result.get("ok"):
        emit_json({"status": "error", "message": "failed to write snapshot"})
        return

    _notify_new_devices(result["new"])
    emit_json({"status": "ok", "new": result["new"], "known": result["known"]})


def scan_ports(target_ip):
    if not target_ip or not re.match(r"^\d+\.\d+\.\d+\.\d+$", target_ip):
        print(json.dumps({"status": "error", "message": "Invalid target IP"}))
        return

    nmap_bin = shutil.which("nmap")
    if not nmap_bin:
        print(json.dumps({"status": "error", "message": "nmap binary not found"}))
        return

    ports = []
    latency = ""
    host_up = False

    try:
        # Fast top ports scan
        cmd = [nmap_bin, "-Pn", "-F", "--open", "-T4", "--max-retries", "1", "--host-timeout", "4s", target_ip]
        raw, _, _ = run_bounded(cmd, timeout=5, max_bytes=MAX_PROC_BYTES)
        stdout = raw.decode("utf-8", "replace")

        for line in stdout.splitlines():
            if len(ports) >= MAX_PORTS:
                break
            line = line.strip()
            if "Host is up" in line:
                host_up = True
                m = re.search(r"\(([\d\.]+s) latency\)", line)
                if m:
                    latency = clamp(m.group(1), 32)

            m_port = re.match(r"^(\d+)/(\w+)\s+(\w+)\s+(\S+)(?:\s+(.*))?$", line)
            if m_port:
                port_num, proto, state, service, ver = m_port.groups()
                if state.lower() == "open":
                    ports.append({
                        "port": f"{port_num}/{proto}",
                        "portNum": int(port_num),
                        "protocol": proto,
                        "state": state,
                        "service": clamp(service),
                        "version": clamp(ver or "")
                    })

    except subprocess.TimeoutExpired:
        pass
    except Exception as e:
        print(json.dumps({"status": "error", "message": clamp(str(e), 256)}))
        return

    emit_json({
        "status": "ok",
        "ip": target_ip,
        "hostUp": host_up or len(ports) > 0,
        "latency": latency or "< 1ms",
        "portCount": len(ports),
        "ports": ports
    })


def _script_map(script_elems):
    """id -> clamped output, capped at MAX_SCRIPTS_PER_PORT entries."""
    out = {}
    for s in script_elems[:MAX_SCRIPTS_PER_PORT]:
        sid = clamp(s.get("id", ""), MAX_FIELD_LEN)
        if not sid:
            continue
        out[sid] = clamp(s.get("output", ""), MAX_SCRIPT_OUTPUT)
    return out


def _extract_http_title(output):
    """nmap's http-title script prefixes its output with "Site title: "."""
    if not output:
        return ""
    text = output.strip()
    prefix = "Site title: "
    if text.startswith(prefix):
        text = text[len(prefix):]
    return clamp(text, MAX_FIELD_LEN)


def _extract_tls_cn(output):
    """First `commonName=` out of ssl-cert's "Subject: ..." line."""
    if not output:
        return ""
    for line in output.splitlines():
        line = line.strip()
        if line.startswith("Subject:"):
            m = re.search(r"commonName=([^/,\n]+)", line)
            if m:
                return clamp(m.group(1), MAX_FIELD_LEN)
    return ""


def _extract_upnp_model(output):
    """First upnp-info line mentioning a model or manufacturer."""
    if not output:
        return ""
    for line in output.splitlines():
        line = line.strip()
        low = line.lower()
        if "model" in low or "manufacturer" in low:
            return clamp(line, MAX_FIELD_LEN)
    return ""


def inspect_host(ip):
    """Deep nmap scan of `ip`: service versions + a handful of NSE scripts.

    scan_ports() stays the fast path this doesn't touch; this is the
    explicit, ~30s-budget "Deep" scan the UI gates behind its own button.
    No -O/-sS: both need root, and only arp-scan gets cap_net_raw from the
    installer, so they'd just fail silently.
    """
    if not ip or not _IP_RE.match(ip):
        emit_json({"status": "error", "message": "Invalid target IP"})
        return

    nmap_bin = shutil.which("nmap")
    if not nmap_bin:
        emit_json({"status": "error", "message": "nmap binary not found"})
        return

    cmd = [
        nmap_bin, "-Pn", "-sV", "--version-light", "-T4", "--open",
        "--top-ports", "200", "--max-retries", "1", "--host-timeout", "25s",
        "--script", "banner,http-title,ssl-cert,upnp-info",
        "-oX", "-", ip,
    ]
    raw, truncated, timed_out = run_bounded(cmd, timeout=35, max_bytes=MAX_PROC_BYTES)

    if truncated:
        # The XML is necessarily incomplete -- don't try to salvage a
        # fragment, just report it plainly.
        emit_json({"status": "error", "message": "scan output truncated"})
        return
    if not raw:
        msg = "nmap produced no output" + (" (timed out)" if timed_out else "")
        emit_json({"status": "error", "message": msg})
        return

    try:
        # Parsing only ever sees the buffer run_bounded() already capped at
        # MAX_PROC_BYTES -- that cap is what keeps this within the memory
        # budget the reviewer asked for; ElementTree itself doesn't resolve
        # external entities, so there's no separate XXE surface here.
        root_el = ET.fromstring(raw)
    except ET.ParseError:
        emit_json({"status": "error", "message": "failed to parse scan output"})
        return
    except Exception:
        emit_json({"status": "error", "message": "failed to parse scan output"})
        return

    try:
        host_el = root_el.find("host")
        host_up = False
        latency = "< 1ms"
        ports = []
        identity = {"httpTitle": "", "tlsCN": "", "upnpModel": "", "banner": ""}

        def _feed_identity(sid, output):
            if sid == "http-title" and not identity["httpTitle"]:
                identity["httpTitle"] = _extract_http_title(output)
            elif sid == "ssl-cert" and not identity["tlsCN"]:
                identity["tlsCN"] = _extract_tls_cn(output)
            elif sid == "upnp-info" and not identity["upnpModel"]:
                identity["upnpModel"] = _extract_upnp_model(output)
            elif sid == "banner" and not identity["banner"]:
                identity["banner"] = clamp(output, MAX_FIELD_LEN)

        if host_el is not None:
            # nmap's own --host-timeout (not run_bounded's byte cap) can fire
            # mid-scan -- most commonly because the `banner` NSE script waits
            # out its full per-port read timeout against a service that never
            # sends one unprompted. When that happens nmap still exits 0 with
            # well-formed XML, but drops <ports>/<hostscript> entirely for
            # that host, so silently reporting "ok" with everything empty
            # would look like a real (if boring) result instead of a scan
            # that never finished.
            if host_el.get("timedout") == "true":
                emit_json({"status": "error", "message": "scan timed out before finishing (host is slow to respond)"})
                return

            status_el = host_el.find("status")
            if status_el is not None:
                host_up = status_el.get("state") == "up"

            times_el = host_el.find("times")
            if times_el is not None:
                srtt = times_el.get("srtt")
                if srtt:
                    try:
                        latency = f"{int(srtt) / 1_000_000:.3f}s"
                    except (ValueError, TypeError):
                        latency = "< 1ms"

            ports_el = host_el.find("ports")
            if ports_el is not None:
                for port_el in ports_el.findall("port"):
                    if len(ports) >= MAX_PORTS:
                        break
                    state_el = port_el.find("state")
                    if state_el is None or state_el.get("state") != "open":
                        continue

                    port_num = port_el.get("portid", "")
                    protocol = clamp(port_el.get("protocol", ""), MAX_FIELD_LEN)

                    service_el = port_el.find("service")
                    service = product = version_num = extrainfo = ""
                    if service_el is not None:
                        service = clamp(service_el.get("name", ""))
                        product = clamp(service_el.get("product", ""))
                        version_num = clamp(service_el.get("version", ""))
                        extrainfo = clamp(service_el.get("extrainfo", ""))
                        tunnel = clamp(service_el.get("tunnel", ""))
                        if tunnel:
                            service = clamp(f"{tunnel}/{service}") if service else tunnel

                    version_parts = [p for p in (product, version_num, extrainfo) if p]
                    version = clamp(" ".join(version_parts))

                    script_elems = port_el.findall("script")
                    for s in script_elems:
                        _feed_identity(s.get("id", ""), s.get("output", ""))

                    ports.append({
                        "port": f"{port_num}/{protocol}",
                        "portNum": int(port_num) if port_num.isdigit() else 0,
                        "protocol": protocol,
                        "state": "open",
                        "service": service,
                        "version": version,
                        "product": product,
                        "versionNum": version_num,
                        "extrainfo": extrainfo,
                        "scripts": _script_map(script_elems)
                    })

            hostscript_el = host_el.find("hostscript")
            if hostscript_el is not None:
                for s in hostscript_el.findall("script"):
                    _feed_identity(s.get("id", ""), s.get("output", ""))

        emit_json({
            "status": "ok",
            "ip": ip,
            "hostUp": host_up,
            "latency": latency,
            "portCount": len(ports),
            "ports": ports,
            "identity": identity
        })
    except Exception:
        emit_json({"status": "error", "message": "failed to parse scan output"})


def _clean_hostname(h, ip):
    """Bound and sanity-check a hostname pulled from a DNS/mDNS resolver.

    The resolver answering is just another device on the network, so a
    hostname is exactly the kind of untrusted, attacker-shapeable string
    the reviewer asked to bound: clamp its length, strip control chars,
    and reject anything that isn't a plausible single hostname token
    (internal whitespace, or simply the IP echoed back).
    """
    if not h:
        return ""
    h = _CONTROL_CHARS_RE.sub("", h).strip()
    if not h or h == ip:
        return ""
    if re.search(r"\s", h):
        return ""
    return clamp(h, 96)


def identify_host(ip):
    """Best-effort reverse-resolve `ip` to a hostname via DNS then mDNS.

    Deliberately NOT part of scan_network() -- it's a per-host, on-demand
    lookup the UI debounces, so it never costs the fast general scan its
    ~1-2s budget.
    """
    if not ip or not _IP_RE.match(ip):
        emit_json({"status": "error", "message": "Invalid target IP"})
        return

    hostname = ""
    source = ""

    getent_bin = shutil.which("getent")
    if getent_bin:
        try:
            raw, _, _ = run_bounded([getent_bin, "hosts", ip], timeout=2, max_bytes=8 * 1024)
            out = raw.decode("utf-8", "replace").strip()
            if out:
                fields = out.splitlines()[0].split()
                if len(fields) >= 2:
                    candidate = _clean_hostname(fields[1], ip)
                    if candidate:
                        hostname, source = candidate, "dns"
        except Exception:
            pass

    if not hostname:
        avahi_bin = shutil.which("avahi-resolve-address")
        if avahi_bin:
            try:
                raw, _, _ = run_bounded([avahi_bin, ip], timeout=2, max_bytes=8 * 1024)
                out = raw.decode("utf-8", "replace").strip()
                if out:
                    fields = out.splitlines()[0].split(None, 1)
                    if len(fields) >= 2:
                        candidate = _clean_hostname(fields[1], ip)
                        if candidate:
                            hostname, source = candidate, "mdns"
            except Exception:
                pass

    emit_json({"status": "ok", "ip": ip, "hostname": hostname, "source": source})


def cmd_alias(args):
    """Dispatch `alias list|set|rm ...`. Always prints JSON, never free text."""
    if not args:
        emit_json({"status": "error", "message": "Usage: alias <list|set|rm> ..."})
        return

    action = args[0]

    if action == "list":
        d = load_aliases()
        emit_json({"status": "ok", "aliases": d, "count": len(d)})
        return

    if action == "set":
        if len(args) < 3:
            emit_json({"status": "error", "message": "Usage: alias set <mac> <name...>"})
            return
        mac = normalize_mac(args[1])
        if not mac:
            emit_json({"status": "error", "message": "Invalid MAC address"})
            return
        name = sanitize_alias(" ".join(args[2:]))
        if not name:
            emit_json({"status": "error", "message": "Alias is empty after sanitizing"})
            return
        d = load_aliases()
        if mac not in d and len(d) >= MAX_ALIASES:
            emit_json({"status": "error", "message": "Alias store is full"})
            return
        d[mac] = name
        if not save_aliases(d):
            emit_json({"status": "error", "message": "Failed to save alias"})
            return
        emit_json({"status": "ok", "mac": mac, "alias": name})
        return

    if action == "rm":
        if len(args) < 2:
            emit_json({"status": "error", "message": "Usage: alias rm <mac>"})
            return
        mac = normalize_mac(args[1])
        if not mac:
            emit_json({"status": "error", "message": "Invalid MAC address"})
            return
        d = load_aliases()
        removed = mac in d
        if removed:
            del d[mac]
            if not save_aliases(d):
                emit_json({"status": "error", "message": "Failed to save alias store"})
                return
        emit_json({"status": "ok", "mac": mac, "removed": removed})
        return

    emit_json({"status": "error", "message": f"Unknown alias subcommand: {clamp(action, 32)}"})


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] == "scan":
        scan_network()
    elif sys.argv[1] == "ports":
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        scan_ports(target)
    elif sys.argv[1] == "alias":
        cmd_alias(sys.argv[2:])
    elif sys.argv[1] == "identify":
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        identify_host(target)
    elif sys.argv[1] == "inspect":
        target = sys.argv[2] if len(sys.argv) > 2 else ""
        inspect_host(target)
    elif sys.argv[1] == "snapshot":
        snapshot()
    else:
        print(json.dumps({"status": "error", "message": "Unknown command"}))
